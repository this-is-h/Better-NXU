{
  "name": "better-nxu",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "imports": {
    "#gm": "vite-plugin-monkey/dist/client/index.js"
  },
  "description": "提高各种 NXU 网站体验的用户脚本（Userscript）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import ./test/setup.mjs --test",
    "test:coverage": "node scripts/run-coverage.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "node scripts/verify-docs.mjs",
    "check": "pnpm run docs && pnpm lint && pnpm test && pnpm build && node scripts/verify-meta.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,vue}": [
      "prettier --write --no-error-on-unmatched-pattern",
      "eslint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,css}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.md": [
      "prettier --write --ignore-unknown --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "vant": "4.9.21",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "vite": "^8.3.0",
    "vite-plugin-monkey": "^8.0.0"
  }
}
